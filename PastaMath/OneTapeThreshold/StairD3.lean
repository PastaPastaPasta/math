def stairD3HD : List HD.Node := stairD3Raw.map fun x => ⟨x.1, x.2.1, x.2.2.1, x.2.2.2⟩
def stairD3HDS : List HDS.Node := stairD3Raw.map fun x => ⟨x.1, x.2.1, x.2.2.1, x.2.2.2⟩

set_option maxRecDepth 200000 in
/-- The node list passes the literal checker `HD.dagCheck` at c = 11386523/10000000, d = 3. -/
theorem stairD3_ok : HD.dagCheck (11386523 / 10000000) 3 1125899906842624 110 stairD3HD 211 = true := by
  decide +kernel

set_option maxRecDepth 200000 in
/-- The node list passes the strict checker `HDS.dagCheck` at c = 11386523/10000000, d = 3. -/
theorem stairD3_sok : HDS.dagCheck (11386523 / 10000000) 3 1125899906842624 110 stairD3HDS 211 = true := by
  decide +kernel

/-- A strict normal-form proof `HY.NF` exists at c = 11386523/10000000, d = 3. -/
theorem stairD3_nf : ∃ Mp n, HY.NF (11386523 / 10000000 : ℝ) 3 Mp n := by
  have h := HD.dagCheck_sound stairD3_ok
  push_cast at h; norm_num at h ⊢
  exact h

/-- A strict normal-form proof `HY.NF` exists at c = 11386523/10000000, d = 3, with kernel time ≥ input
superscript and `HDS.SpOK` (space ≤ time on DTISP kernels) on every line. -/
theorem stairD3_snf : ∃ Mp n, HY.NF (11386523 / 10000000 : ℝ) 3 Mp n ∧
    ∀ i ≤ n, HY.pin (Mp i).1 ≤ (Mp i).2.time ∧ HDS.SpOK (Mp i).2 := by
  have h := HDS.dagCheck_sound stairD3_sok
  push_cast at h; norm_num at h ⊢
  exact h

/-- The same node list in the calculus in which the new log n block of Lemma 3.3 has output exactly 1
(`HY.NFO (fun _ _ => 1)`): a strict normal-form proof exists at c = 11386523/10000000, d = 3, with
kernel time ≥ input superscript and `HDS.SpOK` on every line (via `HDS.dagCheck_sound1`). -/
theorem stairD3_snf1 : ∃ Mp n, HY.NFO (fun _ _ => 1) (11386523 / 10000000 : ℝ) 3 Mp n ∧
    ∀ i ≤ n, HY.pin (Mp i).1 ≤ (Mp i).2.time ∧ HDS.SpOK (Mp i).2 := by
  have h := HDS.dagCheck_sound1 stairD3_sok
  push_cast at h; norm_num at h ⊢
  exact h

/-- The same node list in `HY.StepO ℓ` for every log n output ℓ with `HY.LogOK ℓ`: a strict
normal-form proof `HY.NFO ℓ` exists at c = 11386523/10000000, d = 3, with kernel time ≥ input superscript
and `HDS.SpOK` on every line (via `HDS.dagCheck_soundO`). -/
theorem stairD3_snfO {ℓ : ℝ → ℝ → ℝ} (hℓ : HY.LogOK ℓ) :
    ∃ Mp n, HY.NFO ℓ (11386523 / 10000000 : ℝ) 3 Mp n ∧
      ∀ i ≤ n, HY.pin (Mp i).1 ≤ (Mp i).2.time ∧ HDS.SpOK (Mp i).2 := by
  have h := HDS.dagCheck_soundO hℓ stairD3_sok
  push_cast at h; norm_num at h ⊢
  exact h

