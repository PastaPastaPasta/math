def stairD1HD : List HD.Node := stairD1Raw.map fun x => ⟨x.1, x.2.1, x.2.2.1, x.2.2.2⟩
def stairD1HDS : List HDS.Node := stairD1Raw.map fun x => ⟨x.1, x.2.1, x.2.2.1, x.2.2.2⟩

set_option maxRecDepth 200000 in
/-- The node list passes the literal checker `HD.dagCheck` at c = 130921174/100000000, d = 1. -/
theorem stairD1_ok : HD.dagCheck (130921174 / 100000000) 1 72057594037927936 120 stairD1HD 551 = true := by
  decide +kernel

set_option maxRecDepth 200000 in
/-- The node list passes the strict checker `HDS.dagCheck` at c = 130921174/100000000, d = 1. -/
theorem stairD1_sok : HDS.dagCheck (130921174 / 100000000) 1 72057594037927936 120 stairD1HDS 551 = true := by
  decide +kernel

/-- A strict normal-form proof `HY.NF` exists at c = 130921174/100000000, d = 1. -/
theorem stairD1_nf : ∃ Mp n, HY.NF (130921174 / 100000000 : ℝ) 1 Mp n := by
  have h := HD.dagCheck_sound stairD1_ok
  push_cast at h; norm_num at h ⊢
  exact h

/-- A strict normal-form proof `HY.NF` exists at c = 130921174/100000000, d = 1, with kernel time ≥ input
superscript and `HDS.SpOK` (space ≤ time on DTISP kernels) on every line. -/
theorem stairD1_snf : ∃ Mp n, HY.NF (130921174 / 100000000 : ℝ) 1 Mp n ∧
    ∀ i ≤ n, HY.pin (Mp i).1 ≤ (Mp i).2.time ∧ HDS.SpOK (Mp i).2 := by
  have h := HDS.dagCheck_sound stairD1_sok
  push_cast at h; norm_num at h ⊢
  exact h

/-- The same node list in the calculus in which the new log n block of Lemma 3.3 has output exactly 1
(`HY.NFO (fun _ _ => 1)`): a strict normal-form proof exists at c = 130921174/100000000, d = 1, with
kernel time ≥ input superscript and `HDS.SpOK` on every line (via `HDS.dagCheck_sound1`). -/
theorem stairD1_snf1 : ∃ Mp n, HY.NFO (fun _ _ => 1) (130921174 / 100000000 : ℝ) 1 Mp n ∧
    ∀ i ≤ n, HY.pin (Mp i).1 ≤ (Mp i).2.time ∧ HDS.SpOK (Mp i).2 := by
  have h := HDS.dagCheck_sound1 stairD1_sok
  push_cast at h; norm_num at h ⊢
  exact h

/-- The same node list in `HY.StepO ℓ` for every log n output ℓ with `HY.LogOK ℓ`: a strict
normal-form proof `HY.NFO ℓ` exists at c = 130921174/100000000, d = 1, with kernel time ≥ input superscript
and `HDS.SpOK` on every line (via `HDS.dagCheck_soundO`). -/
theorem stairD1_snfO {ℓ : ℝ → ℝ → ℝ} (hℓ : HY.LogOK ℓ) :
    ∃ Mp n, HY.NFO ℓ (130921174 / 100000000 : ℝ) 1 Mp n ∧
      ∀ i ≤ n, HY.pin (Mp i).1 ≤ (Mp i).2.time ∧ HDS.SpOK (Mp i).2 := by
  have h := HDS.dagCheck_soundO hℓ stairD1_sok
  push_cast at h; norm_num at h ⊢
  exact h

