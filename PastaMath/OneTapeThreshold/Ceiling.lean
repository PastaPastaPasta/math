/-- For every real c ≥ 6547/5000 = 1.3094, with d = 1: (1) there is no strict normal-form proof
`HY.NF c 1 M n`; (2) there is no `RPath c 1 M n` with n ≥ 1 from `([], T a₀)`, a₀ > 0, to `([], T a')`
with a' ≤ a₀; (3) every `HY.Step c 1` path of length n ≥ 1 from `([], T a₀)`, a₀ > 0, to `([], T a')`
has a₀ < a'. -/
theorem ceiling_d1 {c : ℝ} (hc : (6547 / 5000 : ℝ) ≤ c) :
    (∀ M n, ¬ HY.NF c 1 M n) ∧
    (¬ ∃ (M : ℕ → RLine) (n : ℕ) (a₀ a' : ℝ), RPath c 1 M n ∧ 1 ≤ n ∧ 0 < a₀ ∧
      M 0 = ([], .T a₀) ∧ M n = ([], .T a') ∧ a' ≤ a₀) ∧
    (∀ (M : ℕ → HY.Line) (n : ℕ), 1 ≤ n → HY.Path (HY.Step c 1) M n → ∀ a₀ a' : ℝ, 0 < a₀ →
      M 0 = ([], .T a₀) → M n = ([], .T a') → a₀ < a') := by
  have H := hypD1
  have hc' : (((6547 / 5000 : ℚ) : ℚ) : ℝ) ≤ c := by push_cast; linarith
  have hd : (((1 : ℚ) : ℚ) : ℝ) = 1 := by norm_num
  rw [hd] at H
  have hc1 : (1 : ℝ) < (((6547 / 5000 : ℚ) : ℚ) : ℝ) := by norm_num
  refine ⟨fun M n => no_nf_of H hc' M n, ?_, fun M n hn hp a₀ a' ha₀ h0 hN =>
    no_nf_le_of H thD1_gt hc1 hc' M n hn hp ha₀ h0 hN⟩
  rintro ⟨M, n, a₀, a', hp, hn, ha₀, h0, hN, hle⟩
  have := rgt_of H thD1_gt hc1 hc' hp hn ha₀ h0 hN
  linarith

